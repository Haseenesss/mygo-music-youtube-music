{
  "id": "youtube-music",
  "name": "YouTube Music",
  "version": "0.1.0",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "music.youtube.com",
      "s.youtube.com",
      "api.betterlyrics.org"
    ],
    "process": true
  },
  "settings": [
    {
      "key": "programs",
      "label": "Programs Folder",
      "help": "Where ffmpeg is, and yt-dlp if you have it, if they aren't in /opt/homebrew/bin, /usr/local/bin or on the PATH."
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "New Releases",
      "page": "new",
      "icon": "star"
    },
    {
      "builtin": "stations"
    },
    {
      "builtin": "liked"
    }
  ]
}
